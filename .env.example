# LastWell — environment variables. Copy to .env (gitignored) and fill in.
# Each process validates its own variables at boot (gateway: apps/gateway/src/env.ts; eval: apps/eval/src/env.ts; web: lib/env.ts).
# Which process reads which variable, and which are required, is the table in docs/01-ARCHITECTURE.md §8.
# Variables marked (web) or (eval) are ignored by the gateway and vice versa.

# ---- Runtime ----
NODE_ENV=development
PORT=8787
LOG_LEVEL=info
# Public https URL of the gateway (ngrok reserved domain). No trailing slash. wss:// is derived from it.
PUBLIC_BASE_URL=https://your-domain.ngrok-free.app
# Host part of PUBLIC_BASE_URL, used only by the `ngrok http 8787 --domain $NGROK_DOMAIN` command
NGROK_DOMAIN=your-domain.ngrok-free.app
# Shared secret between the web app (server side) and the gateway: `openssl rand -hex 32`
INTERNAL_API_KEY=replace-me

# ---- Twilio (account must be UPGRADED, not trial — docs/09 G-01) ----
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_AUTH_TOKEN=
# The demo number (E.164). Voice webhook: POST {PUBLIC_BASE_URL}/twilio/voice
TWILIO_PHONE_NUMBER=+1415XXXXXXX
# The teammate playing the dispatcher (E.164); inbound calls are bridged here with <Dial>
DISPATCHER_PHONE=+1408XXXXXXX
# Set to false only for local curl tests of the webhook
TWILIO_VALIDATE_SIGNATURE=true

# ---- Cartesia ----
CARTESIA_API_KEY=sk_car_...
CARTESIA_VERSION=2026-08-14
CARTESIA_STT_MODEL=ink-2
CARTESIA_TTS_MODEL=sonic-3.6
# Skylar (en-US). Alternative: 47c38ca4-5f35-497b-b1a3-415245fb35e1 (Daniel). Pick on Friday, then freeze.
CARTESIA_VOICE_ID=db6b0ed5-d5d3-463d-ae85-518a07d3c2b4
# Transcribe the dispatcher's track too (doubles STT usage; set false to save credits)
STT_DISPATCHER_TRACK=true
# Comma-separated keyterms for Ink 2 (≤100 terms, ≤1200 chars total)
STT_KEYTERMS=Eliquis,apixaban,Xarelto,rivaroxaban,Pradaxa,dabigatran,warfarin,Coumadin,Plavix,clopidogrel,Brilinta,Lovenox,tPA,stroke,drooping,slurred,numb,aphasia,insulin,metformin,glucose,seizure,epilepsy,migraine

# ---- Claude API (SDK v1 → API version 2026-10-21; never set temperature/top_p/top_k) ----
ANTHROPIC_API_KEY=sk-ant-...
CLAUDE_FAST_MODEL=claude-haiku-5-5
CLAUDE_REASONER_MODEL=claude-sonnet-5-5
CLAUDE_QA_MODEL=claude-haiku-5-5
CLAUDE_FAST_EFFORT=low
# medium by default; low is the latency escape hatch (docs/09 D-11)
CLAUDE_REASONER_EFFORT=medium
CLAUDE_TIMEOUT_MS=8000

# ---- Pipeline tuning ----
REASONER_INTERVAL_MS=10000
LIKELY_MIN_DISTINCT_SIGNS=2
CALL_TIMEZONE=America/Los_Angeles
# Where the gateway finds eval scripts for replay calls (relative to apps/gateway)
EVAL_SCRIPTS_DIR=../eval/scripts

# ---- Convex (gateway only; the web app has no database access) ----
# `cd apps/gateway && npx convex dev` writes CONVEX_URL (and CONVEX_DEPLOYMENT, CLI-only) to apps/gateway/.env.local; copy CONVEX_URL here.
# The Convex functions check INTERNAL_API_KEY: set the same value in the deployment with `npx convex env set INTERNAL_API_KEY <value>`.
CONVEX_URL=https://happy-animal-123.convex.cloud

# ---- Web app (web) ----
# Server-side proxy target (apps/web/app/api/gateway/[...path]); on laptop 2 use https://<ngrok>
GATEWAY_URL=http://localhost:8787
# Browser connects here directly for live events (ws://localhost:8787/ws/ui on laptop 1; wss://<ngrok>/ws/ui on laptop 2)
NEXT_PUBLIC_GATEWAY_WS_URL=ws://localhost:8787/ws/ui

# ---- Features / demo ----
# Fakes for external services so everything runs without keys (docs/10 §4, D-34): comma-separated from
# claude, stt, tts, twilio, store — or `all`. Leave EMPTY for the demo. The gateway shows a red banner while any fake is on.
LASTWELL_FAKES=
# true on the demo laptop: refuses to boot with any fake active and disables the /api/dev/* routes (D-34)
DEMO_MODE=false
# Outbound calls go ONLY to these numbers (E.164, comma-separated); anything else gets 409 (D-35).
# Put the medical professional's and the dispatcher's phones here. Never a stranger's.
ALERT_ALLOWED_NUMBERS=
# SMS needs an A2P-10DLC-registered number; keep false for the demo (docs/09 G-02)
ALERT_SMS_ENABLED=false
# Prefill the pre-alert target with the caller's number. false since D-30: the briefing goes to a teammate, not the caller
DEMO_ALERT_TO_CALLER=false
# The medical professional's phone (E.164): the Send modal prefills it (D-30). Must also be in ALERT_ALLOWED_NUMBERS
ALERT_DEFAULT_TARGET_PHONE=
# false = one-way briefing, hang up after the mark. Q&A is built last and stays off until two clean rehearsals (D-32)
FEATURE_QA_ENABLED=false
FEATURE_BROWSER_MIC=true

# ---- Eval (eval) ----
EVAL_CONCURRENCY=2
